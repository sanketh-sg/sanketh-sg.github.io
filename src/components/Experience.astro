---
import { experience } from '../data/site';
---

<section id="experience" class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h2 class="text-sm font-semibold tracking-widest text-stone-500 uppercase dark:text-stone-400">Experience</h2>

  <div class="mt-6 rounded-xl border border-stone-200 bg-white p-6 md:p-8 dark:border-stone-800 dark:bg-stone-900">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="text-xl font-semibold tracking-tight">{experience.company}</h3>
      <p class="text-sm text-stone-500 dark:text-stone-400">{experience.period}</p>
    </div>

    <div class="mt-6 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {experience.groups.map((g) => (
        <div>
          <h4 class="font-medium">{g.title}</h4>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-stone-700 dark:text-stone-300">
            {g.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>
