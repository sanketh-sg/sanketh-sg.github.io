---
import { about } from '../data/site';
const [lead, ...rest] = about;
---

<section id="about" class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h2 class="text-sm font-semibold tracking-widest text-stone-500 uppercase dark:text-stone-400">About</h2>
  <p class="mt-6 max-w-3xl text-2xl leading-snug font-semibold tracking-tight">{lead}</p>
  <div class="mt-6 max-w-3xl space-y-4 text-stone-700 dark:text-stone-300">
    {rest.map((p) => <p>{p}</p>)}
  </div>
</section>
