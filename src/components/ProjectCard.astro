---
import type { Project } from '../data/site';
import Chip from './Chip.astro';

interface Props { project: Project; wide?: boolean }
const { project, wide = false } = Astro.props;
const linkCls =
  'font-medium text-stone-900 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900 dark:text-stone-100 dark:decoration-stone-600 dark:hover:decoration-stone-100';
---

<article
  class:list={[
    'glow-card flex flex-col rounded-xl border border-stone-200 bg-white p-6 dark:border-stone-800 dark:bg-stone-900',
    wide && 'md:col-span-2 md:p-8',
  ]}
  style={`--glow: ${project.glow}`}
>
  <h3 class:list={['font-semibold tracking-tight', wide ? 'text-2xl' : 'text-lg']}>{project.name}</h3>
  <p class="mt-1 text-stone-600 dark:text-stone-400">{project.tagline}</p>

  <p class="mt-4 border-l-2 border-stone-900 pl-3 text-sm text-stone-800 dark:border-stone-100 dark:text-stone-200">
    <span class="font-semibold">The hard part: </span>{project.hard}
  </p>

  <ul class:list={['mt-4 list-disc space-y-1 pl-5 text-sm text-stone-700 dark:text-stone-300', wide && 'md:columns-2 md:gap-8']}>
    {project.points.map((p) => <li class="break-inside-avoid">{p}</li>)}
  </ul>

  {project.note && <p class="mt-3 text-xs text-stone-500 dark:text-stone-400">{project.note}</p>}

  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
    {project.tags.map((t) => <Chip label={t} />)}
  </ul>

  {(project.repo || project.live) && (
    <p class="mt-auto flex gap-4 pt-5 text-sm">
      {project.repo && <a class={linkCls} href={project.repo} target="_blank" rel="noopener noreferrer">Source</a>}
      {project.live && <a class={linkCls} href={project.live} target="_blank" rel="noopener noreferrer">Live site</a>}
    </p>
  )}
</article>
